# Copy to .env and fill in. .env is git-ignored.

# Odoo (local test instance from docker-compose: http://localhost:8069)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_test
ODOO_USER=admin
ODOO_PASSWORD=admin

# Alerts. Set alerts.channel in config.toml to "slack", "smtp" or "none".
# Slack incoming webhook URL (Slack app > Incoming Webhooks)
SLACK_WEBHOOK_URL=

# SMTP (used when alerts.channel = "smtp")
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=stock-sync@example.com
ALERT_TO=you@example.com

# Seconds between sync runs when running as a service (docker compose uses this too)
SYNC_INTERVAL_SECONDS=300
